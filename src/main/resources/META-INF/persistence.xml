<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
             https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">


    <persistence-unit name="digital-library-unit">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <class>ir.reza.library.entity.Book</class>
        <class>ir.reza.library.entity.PublisherAddress</class>
        <class>ir.reza.library.entity.StockStatus</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/digital_library_db_hw20"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <property name="jakarta.persistence.jdbc.password"
                      value="8089reza"/>


            <property name="hibernate.show_sql"
                      value="false"/>

            <property name="hibernate.format_sql"
                      value="false"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="create-drop" />
<!--            <property name="jakarta.persistence.schema-generation.database.action"-->
<!--                      value="create"/>-->

        </properties>


    </persistence-unit>

</persistence>